{
  "appId": "com.drvaibhavpatilpune.frametta",
  "appName": "Frametta",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    },
    "Camera": {
      "permissions": ["camera"]
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#000000"
  }
}
